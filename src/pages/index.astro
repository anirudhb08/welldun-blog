---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { series as allSeries, seriesBySlug } from "../series";
import { SITE } from "../site";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.part - b.data.part,
);
const countFor = (slug: string) => posts.filter((p) => p.data.series === slug).length;
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

const site = SITE.url;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: site,
    description: SITE.description,
    publisher: { "@type": "Organization", name: SITE.name, url: site },
  },
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: SITE.name,
    url: site,
    blogPost: posts.slice(0, 10).map((p) => ({
      "@type": "BlogPosting",
      headline: p.data.title,
      datePublished: p.data.date.toISOString(),
      url: new URL(`/posts/${p.slug}/`, site).toString(),
    })),
  },
];
---

<Base title={`${SITE.name} — ${SITE.tagline}`} jsonLd={jsonLd}>
  <div class="wd-container page">
    <header class="page-head">
      <p class="wd-eyebrow">welldun<span class="wd-eyebrow-sep">·</span>Writing</p>
      <h1 class="display-xl">Notes from building infrastructure for AI&nbsp;agents.</h1>
      <p class="lede body-lg">
        We build open-source infrastructure for AI agents that do real work, and write up how it
        works: the bets, the gotchas, and what we measured.
      </p>
    </header>

    <section class="section" id="projects" aria-labelledby="series-title">
      <div class="section-head">
        <h2 id="series-title">Series</h2>
        <span class="section-note">one per project</span>
      </div>
      <div class="card-grid">
        {allSeries.map((s) => {
          const n = countFor(s.slug);
          const planned = s.status === "planned" || n === 0;
          return planned ? (
            <div class="wd-card is-planned">
              <div class="wd-card-top"><p class="wd-eyebrow">Series</p><span class="wd-badge">Soon</span></div>
              <h3 class="wd-card-title">{s.title}</h3>
              <p class="wd-card-desc">{s.dek}</p>
            </div>
          ) : (
            <a class="wd-card" href={`/series/${s.slug}/`}>
              <div class="wd-card-top"><p class="wd-eyebrow">Series</p></div>
              <h3 class="wd-card-title">{s.title}</h3>
              <p class="wd-card-desc">{s.dek}</p>
              <div class="wd-card-meta"><span>{n} part{n === 1 ? "" : "s"}</span><span class="wd-card-go" aria-hidden="true">→</span></div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section" aria-labelledby="latest-title">
      <div class="section-head">
        <h2 id="latest-title">Latest writing</h2>
        <span class="section-note">{posts.length} posts</span>
      </div>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a class="post-row" href={`/posts/${p.slug}/`}>
              <span class="wd-eyebrow">{seriesBySlug[p.data.series]?.title ?? p.data.series}</span>
              <span class="post-row-body">
                <span class="post-row-title">{p.data.title}</span>
                <span class="post-row-dek">{p.data.dek}</span>
              </span>
              <span class="post-row-meta">{fmt(p.data.date)}{p.data.readingTime && <><br />{p.data.readingTime}</>}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
