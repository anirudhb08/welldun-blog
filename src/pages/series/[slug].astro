---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { series as allSeries, seriesBySlug } from "../../series";

export async function getStaticPaths() {
  // only build pages for series that actually have published posts
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const withPosts = new Set(posts.map((p) => p.data.series));
  return allSeries
    .filter((s) => withPosts.has(s.slug))
    .map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const meta = seriesBySlug[slug!];
const posts = (await getCollection("posts", ({ data }) => !data.draft && data.series === slug)).sort(
  (a, b) => a.data.part - b.data.part,
);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Base title={`${meta.title} — a series`} description={meta.dek}>
  <div class="wd-container page">
    <header class="page-head">
      <p class="wd-eyebrow"><a href="/" class="crumb">Writing</a><span class="wd-eyebrow-sep">/</span>Series</p>
      <h1 class="display-lg">{meta.title}</h1>
      <p class="lede body-lg">{meta.dek}</p>
    </header>

    <section class="section" aria-labelledby="parts-title">
      <div class="section-head">
        <h2 id="parts-title">All parts</h2>
        <span class="section-note">{posts.length} posts</span>
      </div>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a class="post-row" href={`/posts/${p.slug}/`}>
              <span class="wd-eyebrow">{p.data.part === 0 ? "Intro" : `Part ${p.data.part}`}</span>
              <span class="post-row-body">
                <span class="post-row-title">{p.data.title}</span>
                <span class="post-row-dek">{p.data.dek}</span>
              </span>
              <span class="post-row-meta">{fmt(p.data.date)}{p.data.readingTime && <><br />{p.data.readingTime}</>}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
