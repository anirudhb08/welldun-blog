---
import Base from "./Base.astro";
import type { CollectionEntry } from "astro:content";
import { seriesBySlug } from "../series";
import { SITE } from "../site";

interface Props {
  post: CollectionEntry<"posts">;
  prev?: CollectionEntry<"posts">;
  next?: CollectionEntry<"posts">;
}
const { post, prev, next } = Astro.props;
const { title, dek, series, part, date, readingTime, tags } = post.data;
const fmtDate = date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const partLabel = part === 0 ? "Series intro" : `Part ${part}`;
const s = seriesBySlug[series];

const url = new URL(`/posts/${post.slug}/`, Astro.site).toString();
const ogImage = `/og/posts/${post.slug}.png`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: dek,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  author: { "@type": "Person", name: SITE.author, url: SITE.authorUrl },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  url,
  image: new URL(ogImage, Astro.site).toString(),
  articleSection: s?.title ?? series,
  keywords: tags.join(", "),
  isPartOf: { "@type": "CreativeWorkSeries", name: s?.title ?? series },
};
---

<Base
  title={`${title} · ${s?.title ?? "Notebook"}`}
  description={dek}
  ogType="article"
  image={ogImage}
  publishedTime={date}
  tags={tags}
  jsonLd={jsonLd}
>
  <article class="wd-container page">
    <header class="article-head">
      <p class="wd-eyebrow">
        <a href={`/series/${series}/`} class="crumb">{s?.title ?? series}</a><span class="wd-eyebrow-sep">·</span>{partLabel}
      </p>
      <h1 class="display-lg">{title}</h1>
      <p class="dek body-lg">{dek}</p>
      <div class="article-meta">
        <time datetime={date.toISOString()}>{fmtDate}</time>
        {readingTime && <><span class="sep">/</span><span>{readingTime}</span></>}
        {tags.length > 0 && <span class="sep">/</span>}
        {tags.map((t) => <span class="wd-badge">{t}</span>)}
      </div>
    </header>

    <div class="wd-prose">
      <slot />
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label="More in this series">
        {prev ? (
          <a class="wd-card" href={`/posts/${prev.slug}/`}>
            <span class="wd-eyebrow">← Previous</span>
            <span class="wd-card-title">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="wd-card next" href={`/posts/${next.slug}/`}>
            <span class="wd-eyebrow">Next →</span>
            <span class="wd-card-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</Base>
