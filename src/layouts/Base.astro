---
import ThemeHead from "../components/ThemeHead.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import "../styles/global.css";
import { SITE } from "../site";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string; // path (absolute or site-relative) to a social image
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  ogType = "website",
  image = "/og/default.png",
  publishedTime,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const SITE_NAME = SITE.name;
const AUTHOR = SITE.author;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const rssUrl = new URL("/rss.xml", Astro.site);

const NAV = [
  { label: "Writing", href: "/" },
  { label: "About", href: "/about/" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" || path.startsWith("/posts/") || path.startsWith("/series/") : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={rssUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === "article" && <meta property="article:author" content={AUTHOR} />}
    {ogType === "article" && tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <link rel="preload" href="/fonts/Figtree.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="wd-header">
      <div class="wd-container wd-header-inner">
        <a class="wd-wordmark" href="/" aria-label="welldun, home"><span>welldun<span class="wd-wordmark-dot">.</span></span></a>
        <nav class="wd-nav" aria-label="Main">
          {NAV.map((l) => (
            <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>
          ))}
        </nav>
        <div class="wd-header-actions">
          <a class="wd-btn wd-btn--ghost wd-btn--sm" href="/rss.xml">RSS</a>
          <a class="wd-btn wd-btn--secondary wd-btn--sm" href={SITE.authorUrl}>Follow on X</a>
        </div>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="wd-footer">
      <div class="wd-container wd-footer-inner">
        <div class="wd-row">
          <a class="wd-wordmark" href="/" aria-label="welldun, home"><span>welldun<span class="wd-wordmark-dot">.</span></span></a>
          <span>Open infrastructure for AI agents, built in public.</span>
        </div>
        <nav class="wd-footer-links" aria-label="Footer">
          <a href="https://github.com/welldunai">GitHub</a>
          <a href={SITE.authorUrl}>X</a>
          <a href="/rss.xml">RSS</a>
          <a href="/about/">About</a>
        </nav>
        <ThemeSwitch />
      </div>
    </footer>
    <script>
      const head = document.querySelector(".wd-header");
      const onScroll = () => head?.setAttribute("data-scrolled", String(window.scrollY > 4));
      onScroll();
      addEventListener("scroll", onScroll, { passive: true });
    </script>
  </body>
</html>
